{
  "name": "google-flow-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server that drives Google Flow (labs.google Veo / Nano Banana) through your own Chrome session — video & image generation plus Scene Builder (extend, jump to, download)",
  "type": "module",
  "license": "MIT",
  "author": "ParkSangGwon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParkSangGwon/google-flow-mcp.git"
  },
  "homepage": "https://github.com/ParkSangGwon/google-flow-mcp#readme",
  "bugs": {
    "url": "https://github.com/ParkSangGwon/google-flow-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-flow",
    "veo",
    "video-generation",
    "scene-builder",
    "playwright",
    "claude",
    "mcp-server",
    "modelcontextprotocol"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "google-flow-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:contract": "npm run build && vitest run --project contract",
    "test:e2e": "vitest run --project e2e",
    "docs:tools": "tsx scripts/gen-tool-docs.ts",
    "docs:check": "tsx scripts/gen-tool-docs.ts --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:contract && npm run docs:check",
    "prepublishOnly": "npm run check",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.62.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
